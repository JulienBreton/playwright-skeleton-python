# Copier ce fichier en .env puis renseigner les valeurs (.env est ignoré par git).
# Les valeurs de .env et les variables d'environnement réelles priment sur environments/<ENV>.env.

# Environnement ciblé (fichier environments/<ENV>.env), "demo" par défaut
ENV=demo

# Serveur Playwright distant (optionnel). Sans valeur, le navigateur est lancé localement.
# PLAYWRIGHT_SERVER=ws://127.0.0.1:3000/

# Compte client (tests ui/customer)
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=

# Compte administrateur (tests ui/admin, nettoyage des données créées)
ADMIN_EMAIL=
ADMIN_PASSWORD=
